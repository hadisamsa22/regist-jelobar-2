rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hadi.samsa22@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Collection: Peserta
    match /peserta/{noRegistrasi} {
      allow read: if true;
      allow create: if isValidId(noRegistrasi);
      allow update, delete: if true;
    }

    // Collection: Pembayaran
    match /pembayaran/{idTransaksi} {
      allow read: if true;
      allow create: if isValidId(idTransaksi);
      allow update, delete: if true;
    }

    // Collection: Rekening Bank
    match /rekening_bank/{bankId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Collection: Pengaturan
    match /pengaturan/{configId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Collection: Audit Logs
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
